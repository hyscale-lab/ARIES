  "plugin": {
    "sdkImport": "openclaw/plugin-sdk/sandbox",
    "registrationFunction": "registerSandboxBackend",
    "registrationMode": "full",
    "backendID": "aries-e2b",
    "localLoadPath": "/opt/aries/openclaw/aries-e2b",
    "manifest": "openclaw.plugin.json",
    "entrypointField": "openclaw.extensions",
    "config": {
      "plugins.enabled": true,
      "plugins.allow": ["aries-e2b"],
      "plugins.load.paths": ["/opt/aries/openclaw/aries-e2b"],
      "plugins.entries.aries-e2b.enabled": true,
      "agents.defaults.sandbox.backend": "aries-e2b",
      "agents.defaults.sandbox.mode": "all",
      "agents.defaults.sandbox.scope": "shared",
      "agents.defaults.sandbox.workspaceAccess": "rw"
    }
  },
  "backend": {
    "createParams": ["sessionKey", "scopeKey", "workspaceDir", "agentWorkspaceDir", "skillsWorkspaceDir", "cfg"],
    "requiredHandleFields": ["id", "runtimeId", "runtimeLabel", "workdir", "buildExecSpec", "runShellCommand"],
    "execSpecFields": ["argv", "env", "stdinMode", "finalizeToken"],
    "buildExecSpecParams": ["command", "workdir", "env", "usePty"],
    "commandParams": ["script", "args", "stdin", "allowFailure", "signal"],
    "managerIsOptional": true,
    "ariesRegistersManager": false
  },
  "filesystemBridge": {
    "methods": ["resolvePath", "readFile", "writeFile", "mkdirp", "remove", "rename", "stat"],
    "hasListDir": false,
    "nativeTools": {
      "enabled": ["read", "write", "edit"],
      "disabled": ["apply_patch"],
      "writeRequiresWorkspaceAccess": "rw"
    }
  },
  "secrets": {
    "tokenConfigField": "tokenFile",
    "tokenFile": "/run/aries/e2b/access.token",
    "tokenBytesInOpenClawJSON": false,
    "pluginEntrySupportsSecretRef": false
  },
  "limitations": {
