+    resetDiagnosticEventsForTest();
+    resetGlobalHookRunner();
+  });
+  afterEach(() => resetDiagnosticEventsForTest());
+
+  it.each(["toolUse", "stop", "error", "aborted"])(
+    "retains response identity/stop reason without content capture: %s",
+    async (stopReason) => {
+      const result = {
+        role: "assistant",
+        stopReason,
+        content: stopReason === "toolUse"
+          ? [{ type: "toolCall", id: "native-tool-a", name: "exec", arguments: { command: "PRIVATE" } }]
+          : [{ type: "text", text: "PRIVATE" }],
+      };
+      const wrapped = wrapStreamFnWithDiagnosticModelCallEvents(
+        (() => ({ result: async () => result, async *[Symbol.asyncIterator]() {
+          yield { type: "done", message: result };
+        } })) as unknown as StreamFn,
+        {
+          runId: "run", provider: "test", model: "test",
+          trace: createDiagnosticTraceContext(),
+          callCategory: "primary_agent_chain",
+          nextCallId: () => "native-model-a",
+        },
+      );
+      const events = await collectTrustedModelCallEvents(async () => {
+        const stream = await wrapped({} as never, {} as never, {} as never);
+        expect(await stream.result()).toBe(result);
+        await drain(stream);
+      });
+      expect(events).toHaveLength(2);
+      const start = events[0].event;
+      const end = events[1].event;
+      expect(start).toMatchObject({
+        callId: "native-model-a", callCategory: "primary_agent_chain",
+        dispatchWallMs: expect.any(Number), dispatchMonoNs: expect.any(String),
+      });
+      expect(end).toMatchObject({
+        responseStopReason: stopReason,
+        returnedToolCallIds: stopReason === "toolUse" ? ["native-tool-a"] : [],
+        responseWallMs: expect.any(Number), responseMonoNs: expect.any(String),
+      });
+      expect(JSON.stringify(events)).not.toContain("PRIVATE");
+      expect(events.every(item => !item.privateData.modelContent)).toBe(true);
+    },
+  );
+});
