#!/usr/bin/env python3
import shlex
import json
import subprocess
import sys
cwd, operation, payload = sys.argv[1:]
args = ['cat', payload] if operation == 'ReadFile' else ['/bin/bash', '-c', payload]
assert operation in ('ReadFile', 'Exec')
# /root is the opening read/lookup workdir. The schedule's remaining calls use the mounted workspace.
command = 'exec deltabox exec "$(cat /run/lite-id)" --project /srv/calendar --fs-read-allow /root/USER.md -- '
if cwd == '/root':
    args = ['/bin/bash', '-c', 'cd /root && exec "$@"', 'bash', *args]
result = subprocess.run(['./guest', command + shlex.join(args)], stdout=subprocess.PIPE)
if not result.stdout:
    sys.exit(result.returncode or 1)
try:
    reply = json.loads(result.stdout)
except ValueError:
    sys.stderr.buffer.write(result.stdout)
    raise
sys.stdout.write(reply['stdout'])
sys.stderr.write(reply['stderr'])
assert not reply['truncated']
sys.exit(reply['exit_code'])
