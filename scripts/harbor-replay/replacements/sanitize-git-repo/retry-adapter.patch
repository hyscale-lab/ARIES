+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/hyscale-lab/aries/pkg/core"
+	"github.com/hyscale-lab/aries/pkg/deployment/vhive"
+	"github.com/hyscale-lab/aries/pkg/replay/harbor"
+)
+
+const sanitizeTask = "sanitize-git-repo"
+
+// Reference hashes bind the three clean files in terminal-bench-2-1
+// 12b7565679ce5006230b820666353673a133db93. The report contains no paths,
+// original values, file contents, or source-process output.
+const sanitizeFinalCheck = `
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+expected = {
+    "ray_processing/ray_cluster.yaml": "4827a78e929c005853df1af502f1a5aae2e2e9ce721ee0d33ab0731eefa128a5",
+    "ray_processing/process.py": "3525f32100c994ee517ba06a355f6d2130c332857da017d921aa8d9252b7022d",
+    "exp_data/datasets/tokenized/rw_v2_fasttext_openhermes_vs_rw_v2_bigram_0.1_arcade100k.json": "2d281c309cb03e9802f532931ac6c1eca129f75c4583ae48996dbb4130f57c0f",
+}
+reference = "d6987af002b122fef54bc0be402062c76488a4d9"
+matches = sum(
+    Path(name).is_file() and hashlib.sha256(Path(name).read_bytes()).hexdigest() == digest
+    for name, digest in expected.items()
+)
+def files(*args):
+    return set(filter(None, subprocess.check_output(["git", *args]).decode().split("\0")))
+
+changed = files("diff", "--no-renames", "--name-only", "-z", reference, "--")
+untracked = files("ls-files", "-z", "--others", "--exclude-standard")
+print(json.dumps({"exact_clean_references": matches, "expected_clean_references": len(expected),
+                  "changed_expected_tracked_files": len(changed & expected.keys()),
+                  "unexpected_tracked_changes": len(changed - expected.keys()),
+                  "untracked_paths": len(untracked)}))
+`
+
+func captureSanitizeResult(ctx context.Context, m *vhive.Manager, id string, r *harbor.Recording, log *json.Encoder, begin int64) error {
+	out, execErr := m.Exec(ctx, id, core.Command{Path: "/usr/local/bin/python", Args: []string{"-c", sanitizeFinalCheck}, Dir: r.Workdir})
+	end, clockErr := harbor.Clock()
+	if err := errors.Join(execErr, clockErr); err != nil {
+		return err
+	}
+	state := map[string]any{"event": "final_task_state_deviation", "exit_code": out.ExitCode,
+		"begin_monotonic_ns": begin, "end_monotonic_ns": end}
+	if out.ExitCode == 0 && json.Valid([]byte(out.Stdout)) {
+		var report struct {
+			Exact      int `json:"exact_clean_references"`
+			Expected   int `json:"expected_clean_references"`
+			Unexpected int `json:"unexpected_tracked_changes"`
+		}
+		if err := json.Unmarshal([]byte(out.Stdout), &report); err != nil {
+			return err
+		}
+		state["checks"] = json.RawMessage(out.Stdout)
+		if report.Expected == 3 && report.Exact == report.Expected && report.Unexpected == 0 {
+			state["event"] = "final_task_state"
+		}
+	}
+	return log.Encode(state)
+}
+
+// This independent observation preserves an existing PNG after the strict
+// viewer rejects its shape. It never changes the first tool reply.
+func observeSanitizePNG(ctx context.Context, m *vhive.Manager, id string, r *harbor.Recording, log *json.Encoder, reply harbor.Receipt) error {
+	if !strings.Contains(reply.Stderr, "unexpected PNG resize in reviewed recording") {
+		return nil
+	}
+	png := ""
+	for _, call := range r.Plan.Calls {
+		if call.Sequence == reply.Sequence && call.Operation == "ViewImage" {
+			png = call.Path
+			break
+		}
+	}
+	if png == "" {
+		return errors.New("PNG observation has no reviewed source path")
+	}
+	begin, err := harbor.Clock()
+	if err != nil {
+		return err
+	}
+	out, captureErr := m.Exec(ctx, id, core.Command{Path: "/usr/local/bin/python", Args: []string{"-c", observeRawPNG, png}})
+	end, err := harbor.Clock()
+	if err != nil {
+		return err
+	}
+	observed := map[string]any{"event": "diagnostic_native_png_raw", "sequence": reply.Sequence, "step_id": reply.Step,
+		"source_call_id": reply.SourceCallID, "monotonic_ns": end, "begin_monotonic_ns": begin,
+		"exit_code": out.ExitCode, "transport_failed": captureErr != nil}
+	if captureErr == nil && out.ExitCode == 0 && json.Valid([]byte(out.Stdout)) {
+		observed["png"] = json.RawMessage(out.Stdout)
+	}
+	return log.Encode(observed)
+}
+
+const observeRawPNG = `
+import base64
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+path = Path(sys.argv[1])
+assert path.is_file()
+with path.open("rb") as image:
+    data = image.read(8 * 1024 * 1024 + 1)
+assert len(data) <= 8 * 1024 * 1024
+assert data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR" and len(data) >= 24
+width, height = struct.unpack(">II", data[16:24])
+assert width > 0 and height > 0
+print(json.dumps({"width": width, "height": height, "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest(),
+                  "content_base64": base64.b64encode(data).decode("ascii")}))
+`
