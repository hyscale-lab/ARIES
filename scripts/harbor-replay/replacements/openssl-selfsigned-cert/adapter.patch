diff --git i/cmd/aries-harbor/openssl_setup.go w/cmd/aries-harbor/openssl_setup.go
new file mode 100644
index 0000000..012c1fd
--- /dev/null
+++ w/cmd/aries-harbor/openssl_setup.go
@@ -0,0 +1,78 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/hyscale-lab/aries/pkg/core"
+	"github.com/hyscale-lab/aries/pkg/deployment/vhive"
+	"github.com/hyscale-lab/aries/pkg/replay/harbor"
+)
+
+const opensslTask = "openssl-selfsigned-cert"
+
+var opensslSetup = taskSetup{
+	output:       "check_cert.py",
+	initialCheck: "test ! -e ssl && test ! -e check_cert.py\nopenssl version\npython --version",
+}
+
+const certificateCheck = `
+openssl verify -check_ss_sig -CAfile ssl/server.crt ssl/server.crt
+python - <<'ARIESPKI'
+from datetime import datetime, timedelta
+from pathlib import Path
+import re
+import ssl
+import stat
+import subprocess
+
+crt = Path("ssl/server.crt")
+key = Path("ssl/server.key")
+pem = Path("ssl/server.pem")
+assert stat.S_IMODE(key.stat().st_mode) == 0o600
+assert stat.S_IMODE(pem.stat().st_mode) & 0o077 == 0
+def openssl(*args, stdin=None):
+    return subprocess.run(["openssl", *args], input=stdin, check=True, capture_output=True).stdout
+
+details = ssl._ssl._test_decode_cert(str(crt))
+subject = dict(attr for dn in details["subject"] for attr in dn)
+assert subject["commonName"] == "dev-internal.company.local"
+assert subject["organizationName"].lower() == "devops team"
+assert details["subject"] == details["issuer"]
+begin = datetime.strptime(details["notBefore"], "%b %d %H:%M:%S %Y %Z")
+end = datetime.strptime(details["notAfter"], "%b %d %H:%M:%S %Y %Z")
+assert end - begin == timedelta(days=365)
+public = openssl("pkey", "-in", str(key), "-pubout")
+assert public == openssl("x509", "-in", str(crt), "-pubkey", "-noout")
+assert b"(2048 bit)" in openssl("rsa", "-pubin", "-text", "-noout", stdin=public)
+assert openssl("pkey", "-in", str(pem), "-pubout") == public
+assert openssl("x509", "-in", str(pem), "-outform", "DER") == openssl("x509", "-in", str(crt), "-outform", "DER")
+report = Path("ssl/verification.txt").read_text().lower()
+fingerprint = openssl("x509", "-in", str(crt), "-noout", "-fingerprint", "-sha256").decode().strip().split("=", 1)[1]
+assert fingerprint.lower() in report
+assert subject["commonName"] in report and subject["organizationName"].lower() in report
+assert re.search(r"\d{4}-\d{2}-\d{2}|[a-z]{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\d{4}", report)
+check = subprocess.run(["python", "/app/check_cert.py"], check=True, capture_output=True, text=True).stdout
+assert subject["commonName"] in check
+assert end.date().isoformat() in check
+assert "Certificate verification successful" in check
+print("CERTIFICATE_VERIFIED rsa_bits=2048 validity_days=365 key_mode=0600 combined_pem_matches=true script_ok=true")
+ARIESPKI
+`
+
+func captureOpenSSL(ctx context.Context, m *vhive.Manager, id string, r *harbor.Recording, log *json.Encoder, cmd string, begin int64) error {
+	out, execErr := m.Exec(ctx, id, core.Command{Path: "/bin/bash", Args: []string{"-lc", cmd + "\n" + certificateCheck}, Dir: r.Workdir})
+	end, clockErr := harbor.Clock()
+	if err := errors.Join(execErr, clockErr); err != nil {
+		return err
+	}
+	event := "final_task_state"
+	if out.ExitCode != 0 {
+		event = "final_task_state_deviation"
+	}
+	return log.Encode(map[string]any{"event": event, "checks": strings.TrimSpace(out.Stdout),
+		"stdout": out.Stdout, "stderr": out.Stderr, "exit_code": out.ExitCode,
+		"begin_monotonic_ns": begin, "end_monotonic_ns": end})
+}
