@@ -0,0 +1,39 @@
+package harbor
+
+import (
+	"context"
+	"testing"
+
+	"github.com/hyscale-lab/aries/pkg/core"
+	"github.com/hyscale-lab/aries/pkg/replay"
+)
+
+func TestReplacementOriginalTerminalShellKeepsItsRealFirstAndAdditionalReplies(t *testing.T) {
+	var records []Receipt
+	call := replay.Call{Operation: "Exec", Sequence: 3, ExitCode: 0, ResponseStdout: []byte("recorded")}
+	ctx := context.Background()
+	hooks := Hooks{
+		ReplacementOpenSSL: true,
+		Record: func(row Receipt) error {
+			records = append(records, row)
+			return nil
+		},
+		FinishObservedProcess: func(_ context.Context, received replay.Call) (core.CommandResult, error) {
+			if received.Sequence != call.Sequence || received.Operation != "Exec" {
+				t.Fatalf("continuation lost source identity: %+v", received)
+			}
+			return core.CommandResult{ExitCode: 2, Stdout: "live remainder"}, nil
+		},
+	}
+	receipt := Receipt{SourceCallID: "source-call", Sequence: call.Sequence, Operation: call.Operation}
+	actual := core.CommandResult{ExitCode: ProcessRunning, Stdout: "live prefix"}
+	if err := recordReply(ctx, hooks, call, receipt, actual, 10, nil); err != nil {
+		t.Fatal(err)
+	}
+	if len(records) != 4 || records[0].Event != "tool_reply" ||
+		*records[0].Exit != ProcessRunning || records[0].Stdout != "live prefix" ||
+		records[3].Event != "relaxed_continuation_end" || *records[3].Exit != 2 ||
+		records[3].Stdout != "live remainder" || records[3].SourceCallID != receipt.SourceCallID {
+		t.Fatalf("unexpected observed replies: %+v", records)
+	}
+}
