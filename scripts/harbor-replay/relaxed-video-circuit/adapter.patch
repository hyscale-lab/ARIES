new file mode 100644
index 0000000..62b1016
--- /dev/null
+++ w/pkg/replay/harbor/relaxed_video_circuit.go
@@ -0,0 +1,73 @@
+package harbor
+
+import (
+	"context"
+	"errors"
+
+	"github.com/hyscale-lab/aries/pkg/core"
+	"github.com/hyscale-lab/aries/pkg/replay"
+)
+
+func RelaxedVideoCircuitTrial(r *Recording) bool {
+	switch r.Trial {
+	case "99c36c5d-aba5-476b-93b2-d08a39c7a353":
+		return r.Task == "circuit-fibsqrt"
+	case "020f911b-467e-49ad-8113-bb725bee1d4b", "361ad8a6-2016-443b-b0c0-22e63f2598c4",
+		"80f95afc-7eb6-4fa4-9c39-13abb473cdc8", "aa067203-b539-48d0-9c99-2128f941c9d0":
+		return r.Task == "video-processing"
+	}
+	return false
+}
+
+// A source-terminal shell that actually yields needs an internal key for
+// its real process. Source process handles remain positive, and the
+// private key is never written into a source call or source receipt.
+func RelaxedForegroundSession(call replay.Call) replay.Call {
+	call.Operation = "StartProcess"
+	call.SessionID = -int(call.Sequence)
+	return call
+}
+
+func recordRelaxedVideoCircuit(ctx context.Context, h Hooks, call replay.Call, reply Receipt, observed core.CommandResult) error {
+	differs := int32(observed.ExitCode) != call.ExitCode
+	imageDiffers := call.Operation == "ViewImage" && observed.Stdout != string(call.ResponseStdout)
+	if !differs && !imageDiffers {
+		return nil
+	}
+	reply.Event = "relaxed_live_deviation"
+	reply.StatusBasis = "observed_first_reply_differs"
+	// The original tool_reply retains the genuine streams. Only the
+	// continuation event can contain additional data from the same process.
+	reply.Stdout, reply.Stderr = "", ""
+	if err := emit(h, reply); err != nil {
+		return err
+	}
+	if observed.ExitCode != ProcessRunning || call.ExitCode < 0 ||
+		(call.Operation != "PollProcess" && call.Operation != "Exec") {
+		return nil
+	}
+	if h.FinishObservedProcess == nil {
+		return errors.New("missing continuation for a genuinely running source-terminal shell")
+	}
+	join := func() error {
+		receipt := reply
+		receipt.Event = "relaxed_continuation_start"
+		receipt.StatusBasis = "actual_process_wait_after_first_reply"
+		if err := emit(h, receipt); err != nil {
+			return err
+		}
+		terminal, err := h.FinishObservedProcess(ctx, call)
+		receipt.Event = "relaxed_continuation_end"
+		receipt.Exit = &terminal.ExitCode
+		receipt.Stdout, receipt.Stderr = terminal.Stdout, terminal.Stderr
+		receipt.StdoutSHA, receipt.StderrSHA = digest([]byte(terminal.Stdout)), digest([]byte(terminal.Stderr))
+		receipt.ProcessTiming = terminal.Timing
+		receipt.OutputComparison = "additional_live_streams"
+		return errors.Join(err, emit(h, receipt))
+	}
+	if h.deferProcessJoin != nil {
+		h.deferProcessJoin(join)
+		return nil
+	}
+	return join()
+}
