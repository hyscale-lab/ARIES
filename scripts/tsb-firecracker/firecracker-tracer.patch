+printf("PFNS %llu %llu %llu %llu\n",(unsigned long long)pfn(p),(unsigned long long)pfn(p+4096),(unsigned long long)pfn(p+8192),(unsigned long long)pfn(p+12288));
+printf("CONTROL_PFN %llu\n",(unsigned long long)pfn(p+16384));
+char b[64];while(fgets(b,sizeof(b),stdin)){if(!strncmp(b,"markers",7)){volatile unsigned char *v=p;unsigned char x=v[0];v[4096]=77;v[8192]=99;v[8192]=0;int f=open("/dev/vda",O_RDONLY|O_DIRECT);ssize_t n=pread(f,p+12288,4096,0);close(f);printf("POST_PFNS %llu %llu %llu %llu\n",(unsigned long long)pfn(p),(unsigned long long)pfn(p+4096),(unsigned long long)pfn(p+8192),(unsigned long long)pfn(p+12288));printf("MARKERS_DONE read=%u restore=%u block=%zd first=%u\n",x,v[8192],n,v[12288]);}else puts("READY");}return 0;}
