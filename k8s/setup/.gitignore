# Your cluster topology — hostnames and usernames stay local.
configs/cluster.json
# What fetch_kubeconfig writes: a copy of the control plane's
# /etc/kubernetes/admin.conf. That embeds a cluster-admin client certificate —
# it is the credential itself, not a pointer to one.
kubeconfig

# aries-setup command logs. They record every command line, including the
# short-lived bootstrap token passed to setup_worker.
aries-setup-*.log
