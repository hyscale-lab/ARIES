# Credentials for the ARIES chart. Copy this file and fill it in:
#
#   cp secret.yaml.example secret.yaml
#
# secret.yaml is gitignored. Pass it last, so it wins over the environment file:
#
#   helm upgrade --install aries ./k8s/aries --namespace aries --create-namespace \
#     -f ./k8s/aries/values-incluster.yaml -f ./k8s/aries/secret.yaml
#
# aries-setup ships this file to the control plane and passes it the same way
# when cluster.json sets deploy_aries, so there is no need to log in to the
# master by hand.
#
# WHERE THESE END UP: Helm stores a release's values in a Secret in the release
# namespace, so both values below are recoverable with `helm get values aries`
# and stay in the release history until those revisions are pruned. Anyone who
# can read Secrets in the namespace can already read the rendered Secrets, so
# this adds the history, not the exposure. Use a key scoped to this project and
# rotate it if the cluster is shared.

model:
  # The model API key. Nothing else in the chart needs to change for a
  # different provider: set model.key to the env var ARIES should read.
  apiKey: sk-replace-me

registry:
  # Only needed when pulling a private ARIES image (registry.create: true,
  # which values-incluster.yaml sets). Delete this block for a public image.
  #
  # Generate the document with kubectl and never apply it — use an access
  # token, not an account password:
  #
  #   kubectl create secret docker-registry aries-registry \
  #     --docker-server=https://index.docker.io/v1/ \
  #     --docker-username=<user> --docker-password=<access-token> \
  #     --dry-run=client -o jsonpath='{.data.\.dockerconfigjson}' \
  #     | base64 -d
  #
  # For GHCR use --docker-server=ghcr.io with a classic PAT holding
  # read:packages. Paste the result below as a single-line JSON string.
  dockerconfigjson: |
    {
      "auths": {
        "https://index.docker.io/v1/": {
          "username": "replace-me",
          "password": "replace-me-with-an-access-token",
          "auth": "cmVwbGFjZS1tZTpyZXBsYWNlLW1lLXdpdGgtYW4tYWNjZXNzLXRva2Vu"
        }
      }
    }
