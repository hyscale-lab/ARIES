# Credentials for the ARIES chart — only needed for a PRIVATE bridge image. The
# published jingxiang212/aries-bridge image is public and needs none of this.
#
# Copy this file and fill it in:
#
#   cp secret.yaml.example secret.yaml
#
# secret.yaml is gitignored. Pass it last, so it wins over the environment file:
#
#   helm upgrade --install aries ./k8s/aries --namespace aries --create-namespace \
#     -f ./k8s/aries/values-cluster.yaml -f ./k8s/aries/secret.yaml \
#     --set registry.create=true --set 'imagePullSecrets[0].name=aries-registry'
#
# For aries-setup, add "secret.yaml" to values_files in
# k8s/setup/configs/aries/aries_config.json; it then ships this file to the control
# plane and passes it the same way.
#
# The model API key is not here any more. The runner runs outside the cluster
# and reads it from DEEPSEEK_API.key beside its binaries; nothing in the
# cluster needs it except the per-task agent pods, which the runner stages it
# into.
#
# WHERE THIS ENDS UP: Helm stores a release's values in a Secret in the release
# namespace, so the document below is recoverable with `helm get values aries`
# and stays in the release history until those revisions are pruned. Use a
# read-only access token scoped to this image.

registry:
  # Only needed when pulling a private bridge image (registry.create: true).
  #
  # Generate the document with kubectl and never apply it — use an access
  # token, not an account password:
  #
  #   kubectl create secret docker-registry aries-registry \
  #     --docker-server=https://index.docker.io/v1/ \
  #     --docker-username=<user> --docker-password=<access-token> \
  #     --dry-run=client -o jsonpath='{.data.\.dockerconfigjson}' \
  #     | base64 -d
  #
  # For GHCR use --docker-server=ghcr.io with a classic PAT holding
  # read:packages. Paste the result below as a single-line JSON string.
  dockerconfigjson: |
    {
      "auths": {
        "https://index.docker.io/v1/": {
          "username": "replace-me",
          "password": "replace-me-with-an-access-token",
          "auth": "cmVwbGFjZS1tZTpyZXBsYWNlLW1lLXdpdGgtYW4tYWNjZXNzLXRva2Vu"
        }
      }
    }
