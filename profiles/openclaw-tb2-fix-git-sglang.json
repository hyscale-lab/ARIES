{
  "name": "openclaw-tb2-fix-git-sglang",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {"concurrency": 1},
  "benchmark": {"type": "terminalbench2", "root": ".cache/terminal-bench-2", "tasks": ["fix-git"]},
  "harness": {"type": "openclaw"},
  "sandbox": {"type": "docker"},
  "bridge": {"type": "openclaw-ssh"},
  "model": {
    "provider": "sglang",
    "base_url": "http://sglang.local:30000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "SGLANG_API_KEY"
  },
  "output_dir": "runs"
}
