{
  "name": "openclaw-tb2-five-deepseek",
  "versions_file": "../configs/versions.json",
  "overrides_file": "../configs/runtime-overrides.json",
  "execution": {
    "concurrency": 2
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2-1",
    "tasks": [
      "fix-git",
      "prove-plus-comm",
      "overfull-hbox",
      "rstan-to-pystan",
      "schemelike-metacircular-eval"
    ]
  },
  "harness": {
    "type": "openclaw",
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "bridge": {
    "type": "openclaw-ssh",
    "mode": "embedded"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash"
  },
  "output_dir": "runs"
}
