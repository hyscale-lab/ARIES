{
  "name": "openclaw-drb-deepseek-k8s-pods",
  "versions_file": "../../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "deepresearchbench",
    "root": ".cache/deep-research-bench",
    "tasks": [
      "1"
    ],
    "environment": {
      "image": "ihasfarm/aries-deepresearchbench:latest",
      "workdir": "/workspace"
    },
    "fact": {
      "jina_api_key_env": "JINA_API_KEY"
    },
    "judge": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "id": "deepseek-flash",
      "reasoning_effort": "low"
    }
  },
  "harness": {
    "type": "openclaw",
    "web_search": {
      "enabled": true,
      "extract_api_key_env": "TAVILY_API_KEY"
    },
    "subagents": {
      "enabled": false
    },
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "node_selector": {
          "aries/role": "worker"
        }
      }
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "pod_cidr": "192.168.0.0/16",
        "service_cidr": "10.96.0.0/12",
        "node_selector": {
          "aries/role": "worker"
        }
      }
    }
  },
  "bridge": {
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "service_account": "aries-bridge",
        "images": {
          "aries-bridge": "ghcr.io/hyscale-lab/aries-bridge"
        },
        "node_selector": {
          "aries/role": "worker"
        }
      }
    },
    "type": "openclaw-ssh",
    "mode": "managed"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash",
    "reasoning_effort": "low"
  },
  "output_dir": "runs"
}
