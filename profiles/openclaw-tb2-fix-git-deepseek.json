{
  "name": "openclaw-tb2-fix-git-deepseek",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "sglang_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2",
    "tasks": ["fix-git"]
  },
  "harness": {
    "type": "openclaw"
  },
  "sandbox": {
    "type": "docker"
  },
  "bridge": {
    "type": "openclaw-ssh"
  },
  "model": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "output_dir": "runs"
}
