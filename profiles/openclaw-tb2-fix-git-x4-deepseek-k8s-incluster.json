{
  "name": "openclaw-tb2-fix-git-x4-deepseek-k8s-incluster",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 4
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2",
    "tasks": [
      "fix-git",
      "fix-git",
      "fix-git",
      "fix-git"
    ]
  },
  "harness": {
    "type": "openclaw",
    "deployment": "kubernetes",
    "namespace": "aries",
    "node_role": "harness"
  },
  "sandbox": {
    "type": "kubernetes",
    "namespace": "aries",
    "node_role": "sandbox",
    "pod_cidr": "192.168.0.0/16",
    "service_cidr": "10.96.0.0/12"
  },
  "bridge": {
    "type": "openclaw-ssh",
    "advertise_host": "$POD_IP"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-v4-flash"
  },
  "output_dir": "runs"
}
