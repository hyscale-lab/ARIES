{
  "name": "codex-tb2-fix-git-openai",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2-1",
    "tasks": [
      "fix-git"
    ]
  },
  "harness": {
    "type": "codex",
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    },
    "mode": "agent",
    "codex": {
      "executable": "../.cache/codex/0.157.1/codex"
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "bridge": {
    "type": "codex-ssh",
    "mode": "embedded"
  },
  "runtime": {
    "backend": "openai",
    "mode": "external"
  },
  "model": {
    "base_url": "http://model.local:8000/v1",
    "api_key_env": "MODEL_API_KEY",
    "id": "replace-with-served-model-id"
  },
  "output_dir": "runs"
}
