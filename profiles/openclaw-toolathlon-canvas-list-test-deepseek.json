{
  "name": "openclaw-toolathlon-canvas-list-test-deepseek",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "toolathlon",
    "root": ".cache/toolathlon",
    "tasks": [
      "canvas-list-test"
    ],
    "environment": {
      "image": "docker.io/lockon0927/toolathlon-task-image:1016beta"
    }
  },
  "harness": {
    "type": "openclaw"
  },
  "sandbox": {
    "type": "docker"
  },
  "bridge": {
    "type": "openclaw-ssh"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash"
  },
  "output_dir": "runs"
}
