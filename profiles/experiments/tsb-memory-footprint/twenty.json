{
  "name": "tsb-memory-footprint-twenty",
  "versions_file": "../../../configs/versions.json",
  "overrides_file": "twenty-overrides.json",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2-1",
    "tasks": [
      "code-from-image",
      "compile-compcert",
      "crack-7z-hash",
      "fix-code-vulnerability",
      "hf-model-inference",
      "kv-store-grpc",
      "overfull-hbox",
      "circuit-fibsqrt",
      "protein-assembly",
      "video-processing",
      "break-filter-js-from-html",
      "constraints-scheduling",
      "count-dataset-tokens",
      "dna-assembly",
      "filter-js-from-html",
      "financial-document-processor",
      "git-leak-recovery",
      "regex-log",
      "sparql-university",
      "torch-tensor-parallelism"
    ]
  },
  "harness": {
    "type": "openclaw",
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "vhive",
      "vhive": {
        "socket": "/run/firecracker-containerd/containerd.sock",
        "namespace": "aries",
        "snapshotter": "devmapper",
        "io_dir": "/run/firecracker-containerd/aries-io",
        "cni_network": "fcnet",
        "idle_mode": "persistent",
        "vcpus": 2,
        "memory_mb": 4096
      }
    }
  },
  "bridge": {
    "deployment": {
      "backend": "docker"
    },
    "type": "openclaw-ssh",
    "mode": "managed"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash",
    "reasoning_effort": "high"
  },
  "output_dir": "runs/tsb-memory-footprint/twenty"
}
