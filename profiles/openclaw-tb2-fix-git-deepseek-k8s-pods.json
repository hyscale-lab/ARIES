{
  "name": "openclaw-tb2-fix-git-deepseek-k8s-pods",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2",
    "tasks": [
      "fix-git"
    ]
  },
  "harness": {
    "type": "openclaw",
    "deployment": "kubernetes",
    "namespace": "aries"
  },
  "sandbox": {
    "type": "kubernetes",
    "namespace": "aries",
    "pod_cidr": "192.168.0.0/16",
    "service_cidr": "10.96.0.0/12"
  },
  "bridge": {
    "type": "openclaw-ssh",
    "deployment": "kubernetes",
    "namespace": "aries"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash"
  },
  "output_dir": "runs"
}
